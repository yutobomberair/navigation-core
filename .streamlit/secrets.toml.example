# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, set these under App settings > Secrets instead
# (do not commit the real secrets.toml — it's already in .gitignore).

SUPABASE_URL = "https://xxxxx.supabase.co"
SUPABASE_KEY = "your-supabase-anon-or-service-key"
OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"  # optional, defaults to gpt-4o-mini

# Optional: lets the web app push a real LINE notification when navigation
# starts (app_platform/services/line_notify.py). Same value as
# management/.env's LINE_CHANNEL_ACCESS_TOKEN. Silently skipped if unset.
# LINE_CHANNEL_ACCESS_TOKEN = "..."
